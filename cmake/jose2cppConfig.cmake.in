@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenSSL 3.0)
find_dependency(nlohmann_json)
# Static builds link zlib; harmless for shared ones.
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/jose2cppTargets.cmake")

# jose::jose, matching the namespace, for code that prefers it. An alias,
# as in the source tree, so it is the same target (CMake 3.18 or later can
# alias an imported target).
if(NOT TARGET jose::jose)
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.18)
        add_library(jose::jose ALIAS jose2cpp::jose2cpp)
    else()
        add_library(jose::jose INTERFACE IMPORTED)
        set_target_properties(jose::jose PROPERTIES INTERFACE_LINK_LIBRARIES jose2cpp::jose2cpp)
    endif()
endif()

check_required_components(jose2cpp)
